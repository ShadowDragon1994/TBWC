+func TestPublishProductReturnsPlatformIdentifiers(t *testing.T) {
+	fake := &fakeTOPClient{result: publishResult{itemID: "123456789", market: "taobao", requestID: "request-1"}}
+	original := newTOPClient
+	newTOPClient = func(runtimeConfig) topClient { return fake }
+	t.Cleanup(func() { newTOPClient = original })
+
+	result, err := (provider{}).PublishProduct(context.Background(), publishRequest())
+	require.NoError(t, err)
