+package taobao
+
+import (
+	"bytes"
+	"context"
+	"encoding/xml"
+	"errors"
+	"fmt"
+	"strconv"
+	"strings"
+
+	platformp "github.com/trademind-ai/trademind/backend/internal/providers/platform"
+)
+
+var errEmptySeller = errors.New("淘宝开放平台未返回卖家信息")
+
+type submitInput struct {
+	market, schema, bizType, barcode string
+	categoryID, spuID                int64
+}
+
+func (provider) PublishProduct(ctx context.Context, req platformp.PublishProductRequest) (*platformp.PublishProductResult, error) {
+	cfg, err := resolveRuntime(ctx, req.Auth)
+	if err != nil {
+		return nil, err
+	}
+	input, err := buildSubmitInput(req)
+	if err != nil {
+		return nil, err
+	}
+	result, err := newTOPClient(cfg).Publish(ctx, cfg.accessToken, input)
+	if err != nil {
+		msg := redactTOPError(err)
+		if strings.Contains(strings.ToLower(msg), "permission") || strings.Contains(msg, "权限") {
+			return nil, fmt.Errorf("%w: %s", platformp.ErrPlatformProductPublishPermissionDenied, msg)
+		}
+		return nil, fmt.Errorf("taobao product publish: %s", msg)
+	}
+	if result.itemID == "" || result.itemID == "0" {
+		return nil, fmt.Errorf("taobao product publish: platform did not return item id")
+	}
+	return &platformp.PublishProductResult{
+		ExternalProductID: result.itemID,
+		ExternalSPUID:     strconv.FormatInt(input.spuID, 10),
+		ExternalURL:       listingURL(input.market, result.itemID),
+		Status:            "published",
+		SKUMappings:       nil, // submit does not return remote SKU IDs; a later detail sync must bind them.
+		RawSummary:        platformp.TrimRawMap(map[string]any{"provider": "taobao", "market": result.market, "requestId": result.requestID, "createTime": result.createTime, "categoryId": input.categoryID, "submittedSkuCount": len(req.Product.SKUs)}, 10, 180),
+	}, nil
+}
+
+func buildSubmitInput(req platformp.PublishProductRequest) (submitInput, error) {
+	value := func(key string) string {
+		if req.Options != nil {
+			if v := strings.TrimSpace(fmt.Sprint(req.Options[key])); v != "" && v != "<nil>" {
+				return v
+			}
+		}
+		if req.PublishConfig != nil {
+			if v := strings.TrimSpace(fmt.Sprint(req.PublishConfig[key])); v != "" && v != "<nil>" {
+				return v
+			}
+		}
+		return ""
+	}
+	market := strings.ToLower(value("market"))
+	if market == "" {
+		market = "taobao"
+	}
+	if market != "taobao" && market != "tmall" && market != "litetao" {
+		return submitInput{}, fmt.Errorf("taobao product publish: invalid market %q", market)
+	}
+	categoryID, err := strconv.ParseInt(value("default_category_id"), 10, 64)
+	if override := value("category_id"); override != "" {
+		categoryID, err = strconv.ParseInt(override, 10, 64)
+	}
+	if err != nil || categoryID <= 0 {
+		return submitInput{}, fmt.Errorf("taobao product publish: category_id is required")
+	}
+	spuID, _ := strconv.ParseInt(value("default_spu_id"), 10, 64)
+	if override := value("spu_id"); override != "" {
+		spuID, err = strconv.ParseInt(override, 10, 64)
+		if err != nil || spuID <= 0 {
+			return submitInput{}, fmt.Errorf("taobao product publish: invalid spu_id")
+		}
+	}
+	if market == "tmall" && spuID <= 0 {
+		return submitInput{}, fmt.Errorf("taobao product publish: spu_id is required for tmall")
+	}
+	template := value("schema_template")
+	if schema := value("item_schema"); schema != "" {
+		template = schema
+	}
+	if template == "" {
+		return submitInput{}, fmt.Errorf("taobao product publish: schema_template is required")
+	}
+	schema := renderSchema(template, req)
+	if err := xml.Unmarshal([]byte(schema), new(any)); err != nil {
+		return submitInput{}, fmt.Errorf("taobao product publish: invalid schema XML: %w", err)
+	}
+	return submitInput{market: market, categoryID: categoryID, spuID: spuID, bizType: value("biz_type"), barcode: value("barcode"), schema: schema}, nil
+}
+
+func renderSchema(template string, req platformp.PublishProductRequest) string {
+	mainImage := ""
+	if len(req.Product.Images) > 0 {
+		mainImage = req.Product.Images[0].URL
+	}
+	price, stock, skuCode := "", "", ""
+	if len(req.Product.SKUs) > 0 {
+		price = strconv.FormatFloat(req.Product.SKUs[0].Price, 'f', -1, 64)
+		stock = strconv.Itoa(req.Product.SKUs[0].Stock)
+		skuCode = req.Product.SKUs[0].SKUCode
+	}
+	escape := func(value string) string {
+		var out bytes.Buffer
+		_ = xml.EscapeText(&out, []byte(value))
+		return out.String()
+	}
+	values := map[string]string{"title": req.Product.Title, "description": req.Product.Description, "main_image_url": mainImage, "price": price, "stock": stock, "sku_code": skuCode}
+	for key, value := range values {
+		template = strings.ReplaceAll(template, "{{"+key+"}}", escape(value))
+	}
+	return template
+}
+
+func listingURL(market, itemID string) string {
+	if market == "tmall" {
+		return "https://detail.tmall.com/item.htm?id=" + itemID
+	}
+	return "https://item.taobao.com/item.htm?id=" + itemID
+}
+
+func redactTOPError(err error) string {
+	if err == nil {
+		return ""
+	}
+	msg := strings.TrimSpace(err.Error())
+	if len(msg) > 400 {
+		msg = msg[:400]
+	}
+	return msg
+}
