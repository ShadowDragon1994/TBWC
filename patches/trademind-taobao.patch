+function apiErrorFromUnknown(error: unknown): Error {
+  const candidate = error as {
+    response?: { data?: Partial<ApiResponse<unknown>> };
+    data?: Partial<ApiResponse<unknown>>;
+    message?: string;
+  };
+  const body = candidate?.response?.data ?? candidate?.data;
+  if (body && typeof body === 'object' && typeof body.message === 'string' && body.message.trim()) {
+    return new ApiRequestError({
+      code: typeof body.code === 'number' ? body.code : -1,
+      message: body.message,
+      data: body.data,
+      traceId: body.traceId,
+    });
+  }
+  return error instanceof Error ? error : new Error(candidate?.message || 'request_failed');
+}
+
+async function apiRequest<T>(path: string, options: Parameters<typeof request>[1]): Promise<ApiResponse<T>> {
+  try {
+    return await request<ApiResponse<T>>(path, options);
+  } catch (error: unknown) {
+    throw apiErrorFromUnknown(error);
+  }
+}
