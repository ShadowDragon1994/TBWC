+package taobao
+
+import (
+	"context"
+	"strconv"
+
+	itemapi "github.com/bububa/opentaobao/api/tbitem"
+	userapi "github.com/bububa/opentaobao/api/tbuser"
+	"github.com/bububa/opentaobao/core"
+	itemmodel "github.com/bububa/opentaobao/model/tbitem"
+	usermodel "github.com/bububa/opentaobao/model/tbuser"
+)
+
+type sellerResult struct{ nick, id string }
+type publishResult struct {
+	itemID, market, requestID, createTime string
+}
+
+type topClient interface {
+	Seller(ctx context.Context, session string) (sellerResult, error)
+	Publish(ctx context.Context, session string, input submitInput) (publishResult, error)
+}
+
+type sdkClient struct{ client *core.SDKClient }
+
+var newTOPClient = func(cfg runtimeConfig) topClient { return sdkClient{client: newSDK(cfg)} }
+
+func (c sdkClient) Seller(ctx context.Context, session string) (sellerResult, error) {
+	req := usermodel.NewTaobaoUserSellerGetRequest()
+	_ = req.SetFields([]string{"user_id", "nick", "status", "has_shop"})
+	resp := new(usermodel.TaobaoUserSellerGetAPIResponse)
+	if err := userapi.TaobaoUserSellerGet(ctx, c.client, req, resp, session); err != nil {
+		return sellerResult{}, err
+	}
+	if resp.User == nil {
+		return sellerResult{}, errEmptySeller
+	}
+	return sellerResult{nick: resp.User.Nick, id: strconv.FormatInt(resp.User.UserId, 10)}, nil
+}
+
+func (c sdkClient) Publish(ctx context.Context, session string, input submitInput) (publishResult, error) {
+	req := itemmodel.NewAlibabaItemPublishSubmitRequest()
+	_ = req.SetMarket(input.market)
+	_ = req.SetCatId(input.categoryID)
+	_ = req.SetSchema(input.schema)
+	if input.spuID > 0 {
+		_ = req.SetSpuId(input.spuID)
+	}
+	if input.bizType != "" {
+		_ = req.SetBizType(input.bizType)
+	}
+	if input.barcode != "" {
+		_ = req.SetBarcode(input.barcode)
+	}
+	resp := new(itemmodel.AlibabaItemPublishSubmitAPIResponse)
+	if err := itemapi.AlibabaItemPublishSubmit(ctx, c.client, req, resp, session); err != nil {
+		return publishResult{}, err
+	}
+	return publishResult{itemID: strconv.FormatInt(resp.ItemId, 10), market: resp.Market, requestID: resp.RequestId, createTime: resp.CreateTime}, nil
+}
