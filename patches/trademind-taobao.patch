+package taobao
+
+import (
+	"context"
+	"fmt"
+	"strings"
+
+	"github.com/bububa/opentaobao/core"
+	platformp "github.com/trademind-ai/trademind/backend/internal/providers/platform"
+)
+
+type provider struct{}
+
+func NewProvider() platformp.Provider { return provider{} }
+
+func (provider) Platform() string { return "taobao" }
+func (provider) Name() string     { return "淘宝 / 天猫开放平台" }
+func (provider) Status() string   { return platformp.StatusBeta }
+func (provider) Capabilities() []platformp.Capability {
+	return []platformp.Capability{platformp.CapShopInfo, platformp.CapProductPublish}
+}
+func (provider) AuthSchema() platformp.AuthSchema {
+	return platformp.AuthSchema{AuthType: "oauth2", Fields: []platformp.AuthField{
+		{Name: "accessToken", Label: "Session / Access Token", Type: "password", Required: true, Sensitive: true, Hint: "淘宝开放平台店铺授权后取得的 Session。"},
+	}}
+}
+func (provider) AppConfigSchema() platformp.PlatformAppConfigSchema {
+	return platformp.TaobaoAppConfigSchema()
+}
+func (provider) PublishConfigSchema() platformp.PlatformAppConfigSchema {
+	return platformp.PublishConfigPresetForPlatform("taobao")
+}
+
+func (provider) TestConnection(ctx context.Context, req platformp.TestConnectionRequest) (*platformp.TestConnectionResult, error) {
+	cfg, err := resolveRuntime(ctx, req)
+	if err != nil {
+		return &platformp.TestConnectionResult{OK: false, Message: err.Error()}, nil
+	}
+	user, err := newTOPClient(cfg).Seller(ctx, cfg.accessToken)
+	if err != nil {
+		return &platformp.TestConnectionResult{OK: false, Message: redactTOPError(err)}, nil
+	}
+	return &platformp.TestConnectionResult{OK: true, Message: "淘宝开放平台连接正常", ShopName: user.nick, ExternalShopID: user.id, Currency: "CNY"}, nil
+}
+
+type runtimeConfig struct {
+	appKey, appSecret, accessToken, gateway string
+	sandbox                                 bool
+}
+
+func resolveRuntime(ctx context.Context, auth platformp.TestConnectionRequest) (runtimeConfig, error) {
+	global := map[string]string{}
+	if shopsBridge != nil {
+		m, err := shopsBridge.TaobaoGlobalSettings(ctx)
+		if err != nil {
+			return runtimeConfig{}, fmt.Errorf("load taobao settings: %w", err)
+		}
+		global = m
+	}
+	first := func(values ...string) string {
+		for _, value := range values {
+			if value = strings.TrimSpace(value); value != "" {
+				return value
+			}
+		}
+		return ""
+	}
+	cfg := runtimeConfig{
+		appKey:      first(auth.AppKey, global["app_key"]),
+		appSecret:   first(auth.AppSecret, global["app_secret"]),
+		accessToken: strings.TrimSpace(auth.AccessToken),
+		gateway:     first(auth.Extra["api_gateway"], global["api_gateway"]),
+		sandbox:     truthy(first(auth.Extra["sandbox_enabled"], global["sandbox_enabled"])),
+	}
+	if cfg.appKey == "" || cfg.appSecret == "" {
+		return runtimeConfig{}, fmt.Errorf("淘宝开放平台 App Key/App Secret 未配置")
+	}
+	if cfg.accessToken == "" {
+		return runtimeConfig{}, fmt.Errorf("淘宝店铺 Session/Access Token 未配置")
+	}
+	return cfg, nil
+}
+
+func truthy(value string) bool {
+	switch strings.ToLower(strings.TrimSpace(value)) {
+	case "1", "true", "yes", "on":
+		return true
+	default:
+		return false
+	}
+}
+
+func newSDK(cfg runtimeConfig) *core.SDKClient {
+	client := core.NewSDKClient(cfg.appKey, cfg.appSecret)
+	if cfg.gateway != "" {
+		client.SetGateway(cfg.gateway)
+	}
+	if cfg.sandbox {
+		client.UseSandbox()
+	}
+	return client
+}
