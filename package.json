{
  "name": "zaowutai",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c yellow,cyan \"npm:dev:server\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build": "npm run build:server && tsc -b && vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "test": "vitest run",
    "lint": "eslint ."
  },
  "dependencies": {
    "@vitejs/plugin-react": "4.7.0",
    "concurrently": "^9.2.1",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "jszip": "^3.10.1",
    "lucide-react": "0.468.0",
    "multer": "^2.0.2",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "tsx": "^4.20.6",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@testing-library/user-event": "latest",
    "@types/express": "^5.0.5",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.10.1",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@types/supertest": "^6.0.3",
    "eslint": "latest",
    "eslint-plugin-react-hooks": "latest",
    "eslint-plugin-react-refresh": "latest",
    "globals": "latest",
    "jsdom": "latest",
    "playwright": "^1.57.0",
    "supertest": "^7.1.4",
    "vitest": "3.2.7"
  }
}
